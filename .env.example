# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
SECRET_KEY=change-me-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# Docker Compose (service name as host):
DATABASE_URL=postgresql+asyncpg://chemflow:chemflow@postgres:5432/chemflow_intelligence
# Local (without Docker):
# DATABASE_URL=postgresql+asyncpg://chemflow:chemflow@localhost:5434/chemflow_intelligence

# ─── Redis / Celery ───────────────────────────────────────────────────────────
# Docker Compose:
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Local (without Docker):
# REDIS_URL=redis://localhost:6380/0
# CELERY_BROKER_URL=redis://localhost:6380/0
# CELERY_RESULT_BACKEND=redis://localhost:6380/1

# ─── Anthropic (Claude API — Explainability Layer) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6

# ─── PubChem ──────────────────────────────────────────────────────────────────
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# ─── ECHA / GHS ───────────────────────────────────────────────────────────────
ECHA_API_BASE_URL=https://iuclid6.echa.europa.eu/api

# ─── AiZynthFinder ────────────────────────────────────────────────────────────
AIZYNTHFINDER_CONFIG_PATH=/app/config/aizynthfinder.yml
AIZYNTHFINDER_STOCK_FILE=/app/data/zinc_stock.hdf5

# ─── Job Settings ─────────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=180
JOB_RETENTION_DAYS=30

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
